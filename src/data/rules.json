    {
      "id": "mixed-combinations",
      "title": "六、辅元字母组合拼读规则（部分示例）",
      "color": "amber",
      "rules": [
        { "combination": "al", "sounds": "/ɔː/（chalk）、/ɔːl/（almost）" },
        { "combination": "aw", "sounds": "/ɔː/（awful）" },
        { "combination": "ew", "sounds": "/juː/（new）" },
        { "combination": "ind/ild", "sounds": "/aɪnd/（mind）、/aɪld/（child）" },
        { "combination": "igh/ign", "sounds": "/aɪ/（light）、/aɪn/（sign）" },
        { "combination": "ing", "sounds": "/ɪŋ/（doing）" },
        { "combination": "ow", "sounds": "/aʊ/（down）、/əʊ/（flow）" },
        { "combination": "ought", "sounds": "/ɔːt/（thought）" },
        { "combination": "gu", "sounds": "/ɡ/（guard）" },
        { "combination": "sion/tion", "sounds": "元音后 /ʒn/（television），辅音后 /ʃn/（tension）" },
        { "combination": "sure/ture", "sounds": "/ʒə/（pleasure）、/tʃə/（future）" }
      ]
    }
  ]
}
